{% extends "emails/base.njk" %}

{% block content %}
<h2>Password Reset Successful</h2>

<p>Hi {{ name | default("there") }},</p>

<p>Your password has been successfully reset. You can now log in to your FinAnalysis account with your new password.</p>

<div class="info-box">
    <p><strong>Security Note:</strong> If you didn't make this change, please contact our support team immediately.</</p>
</div>

<p>You can now log in to your account using your new password.</p>

<div class="button">
    <a href="{{ loginUrl }}">Log in to FinAnalysis</a>
</div>

<p>If you didn't request this change, please contact our support team immediately.</p>

<p>Best regards,<br>
The FinAnalysis Team</p>
{% endblock %}